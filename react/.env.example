# Firebase web app settings for highlight sync (Google sign-in + Firestore).
# Copy to .env.local for local development; on GitHub add them as repository
# variables (Settings -> Secrets and variables -> Actions -> Variables).
# These values are public by design (they end up in the browser); access is
# protected by firestore.rules and the authorized domains in Firebase Auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
